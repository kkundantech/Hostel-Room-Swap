# ============================================
# Backend Environment Variables
# ============================================

# Django Settings
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings

# Database (PostgreSQL)
DATABASE_NAME=hostel_exchange
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Frontend URL (for password reset links, etc.)
FRONTEND_URL=http://localhost:5173

# Policy Defaults
DEFAULT_COOLING_OFF_DAYS=30
DEFAULT_REQUEST_VALIDITY_DAYS=14
DEFAULT_PROPOSAL_EXPIRY_HOURS=48
DEFAULT_MAX_CYCLE_LENGTH=5

# External Integrations (Mock Mode)
P03_API_URL=
P03_API_KEY=
ERP_API_URL=
ERP_API_KEY=
INTEGRATION_MOCK_MODE=True

# SMS Gateway (Optional)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_ENABLED=False
