# ==============================================================================
# Backend Local Environment Variables Template
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=change-to-a-cryptographically-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings

# Database (PostgreSQL 16)
DATABASE_NAME=hostel_exchange
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_postgresql_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_CONN_MAX_AGE=60

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Email (SMTP / Console Dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Policy Defaults
DEFAULT_COOLING_OFF_DAYS=30
DEFAULT_REQUEST_VALIDITY_DAYS=14
DEFAULT_PROPOSAL_EXPIRY_HOURS=48
DEFAULT_MAX_CYCLE_LENGTH=5

# External Integrations (Mock Mode)
INTEGRATION_MOCK_MODE=True
P03_API_URL=
P03_API_KEY=
ERP_API_URL=
ERP_API_KEY=
