# ==============================================================================
# HostelSwap — Production Environment Variables Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to '.env.production' or '.env' on your production server.
# 2. Generate a secure secret key:
#      python -c "import secrets; print(secrets.token_urlsafe(50))"
# 3. Populate all required values. NEVER commit production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Backend Core Settings
# ------------------------------------------------------------------------------
# MANDATORY: A cryptographically strong 50+ character random string
DJANGO_SECRET_KEY=generate_with_python_secrets_token_urlsafe_50_minimum

# MANDATORY: Must be False in production!
DJANGO_DEBUG=False

# Comma-separated list of fully qualified domain names and server IPs
# Example: hostelswap.youruniversity.edu,api.youruniversity.edu,203.0.113.195
DJANGO_ALLOWED_HOSTS=hostelswap.example.edu,api.example.edu,localhost,127.0.0.1

DJANGO_SETTINGS_MODULE=config.settings

# ------------------------------------------------------------------------------
# 2. CORS & CSRF Security Controls
# ------------------------------------------------------------------------------
# Origins allowed to make browser-based API requests
CORS_ALLOWED_ORIGINS=https://hostelswap.example.edu,https://api.example.edu

# Trusted origins for state-changing HTTP methods (POST, PUT, DELETE)
CSRF_TRUSTED_ORIGINS=https://hostelswap.example.edu,https://api.example.edu

# Cookies & HTTPS Security (Leave True unless on an internal testbed)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 3. Production PostgreSQL 16 Database
# ------------------------------------------------------------------------------
# Option A: Discrete variables (Standard for Docker Compose / VPS)
DATABASE_NAME=hostel_exchange_prod
DATABASE_USER=hostelswap_user
DATABASE_PASSWORD=your_strong_generated_db_password_here
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60
USE_SQLITE=False

# Option B: Cloud Database Connection String (Render / Railway / Supabase / Neon)
# DATABASE_URL=postgresql://user:password@hostname:5432/database_name

# ------------------------------------------------------------------------------
# 4. Redis Cache & Celery Task Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------------------------------------------------------
# 5. Production Institutional Email (SMTP)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@hostel.example.edu
EMAIL_HOST_PASSWORD=your_16_character_smtp_app_password
DEFAULT_FROM_EMAIL=HostelSwap Security <notifications@hostel.example.edu>

# ------------------------------------------------------------------------------
# 6. External Institutional ERP / P03 Integration
# ------------------------------------------------------------------------------
# Set to False once connected to real institutional API endpoints
INTEGRATION_MOCK_MODE=True
P03_API_BASE_URL=https://p03-api.example.edu/api/v1
P03_API_CLIENT_ID=your_p03_client_id
P03_API_CLIENT_SECRET=your_p03_client_secret
P03_SYNC_TIMEOUT_SECONDS=10
P03_RETRY_ATTEMPTS=3

ERP_API_URL=https://erp-api.example.edu/api/v1
ERP_API_KEY=your_erp_api_key

# ------------------------------------------------------------------------------
# 7. Frontend Client Settings
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://hostelswap.example.edu/api/v1
FRONTEND_URL=https://hostelswap.example.edu
VITE_ENABLE_DEMO=false

# ------------------------------------------------------------------------------
# 8. Docker Deployment Ports
# ------------------------------------------------------------------------------
PORT=80
SSL_PORT=443
DOCKER_DB_PORT=5432
DOCKER_REDIS_PORT=6379
