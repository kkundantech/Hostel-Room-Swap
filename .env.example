# ==============================================================================
# HostelSwap — Local & Production Environment Configuration Template
# Hostel Room Exchange & Multi-Party Swap Platform
#
# IMPORTANT SECURITY NOTICE FOR DEPLOYMENT:
# Copy this file to '.env' and populate with cryptographically secure values.
# NEVER commit the active '.env' file to version control.
# To generate a high-entropy secret key in Python:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Backend Core Settings
# ------------------------------------------------------------------------------
# Set to a cryptographically strong 50+ character random string in production
DJANGO_SECRET_KEY=change-to-a-cryptographically-random-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,hostelswap.example.edu
DJANGO_SETTINGS_MODULE=config.settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://hostelswap.example.edu

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL 16)
# ------------------------------------------------------------------------------
DATABASE_NAME=hostel_exchange
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_postgresql_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_CONN_MAX_AGE=60

# ------------------------------------------------------------------------------
# 3. Redis & Celery Message Broker
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# 4. Institutional Email Delivery (Production SMTP / Console Dev)
# ------------------------------------------------------------------------------
# Set EMAIL_BACKEND to 'django.core.mail.backends.console.EmailBackend' for local testing
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@hostel.example.edu
EMAIL_HOST_PASSWORD=your_institutional_email_app_password_here
DEFAULT_FROM_EMAIL=HostelSwap Security <notifications@hostel.example.edu>

# ------------------------------------------------------------------------------
# 5. External P03 Hostel & ERP System Integration (Mock / Production API)
# ------------------------------------------------------------------------------
# Set INTEGRATION_MOCK_MODE=False only when official institutional API keys are provisioned
INTEGRATION_MOCK_MODE=True
P03_API_BASE_URL=https://p03-api.example.edu/api/v1
P03_API_CLIENT_ID=hostelswap_client_id_placeholder
P03_API_CLIENT_SECRET=hostelswap_client_secret_placeholder
P03_SYNC_TIMEOUT_SECONDS=10
P03_RETRY_ATTEMPTS=3

ERP_API_URL=https://erp-api.example.edu/api/v1
ERP_API_KEY=erp_client_secret_placeholder

# ------------------------------------------------------------------------------
# 6. Platform Governance & Swap Policy Defaults
# ------------------------------------------------------------------------------
DEFAULT_COOLING_OFF_DAYS=30
DEFAULT_REQUEST_VALIDITY_DAYS=14
DEFAULT_PROPOSAL_EXPIRY_HOURS=48
DEFAULT_MAX_CYCLE_LENGTH=5
DEFAULT_REQUIRE_FEE_CLEARANCE=True
DEFAULT_CHECK_DISCIPLINARY_HOLD=True

# ------------------------------------------------------------------------------
# 7. Frontend Client Settings
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:3000
VITE_ENABLE_DEMO=false
