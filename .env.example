# ==============================================================================
# RoomSwap — Production & Local Development Environment Variables
# Lovely Professional University (LPU) Hostel Exchange & Multi-Party Swap Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Backend Core Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=production-crypto-secret-key-replace-with-safe-entropy
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,roomswap.lpu.in
DJANGO_SETTINGS_MODULE=config.settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://roomswap.lpu.in

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL with Transaction & Row-Locking Support)
# ------------------------------------------------------------------------------
DATABASE_NAME=hostel_exchange
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_db_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ------------------------------------------------------------------------------
# 3. Redis & Celery Message Broker
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# 4. Institutional Email Delivery (Production SMTP / Console Dev)
# ------------------------------------------------------------------------------
# Use 'django.core.mail.backends.smtp.EmailBackend' for production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@hostel.lpu.in
EMAIL_HOST_PASSWORD=institutional_app_specific_password
DEFAULT_FROM_EMAIL=RoomSwap Administration <notifications@hostel.lpu.in>

# ------------------------------------------------------------------------------
# 5. P03 Hostel Allocation System Integration
# ------------------------------------------------------------------------------
# When actual university P03 API credentials are provided, set INTEGRATION_MOCK_MODE=False
INTEGRATION_MOCK_MODE=True
P03_API_BASE_URL=https://p03.lpu.in/api/v1
P03_API_CLIENT_ID=roomswap_integration_client
P03_API_CLIENT_SECRET=p03_production_secret_token
P03_SYNC_TIMEOUT_SECONDS=30
P03_RETRY_ATTEMPTS=3

# ------------------------------------------------------------------------------
# 6. Governance & Policy Defaults
# ------------------------------------------------------------------------------
DEFAULT_COOLING_OFF_DAYS=30
DEFAULT_REQUEST_VALIDITY_DAYS=14
DEFAULT_PROPOSAL_EXPIRY_HOURS=48
DEFAULT_MAX_CYCLE_LENGTH=5
DEFAULT_REQUIRE_FEE_CLEARANCE=True
DEFAULT_CHECK_DISCIPLINARY_HOLD=True

# ------------------------------------------------------------------------------
# 7. Frontend Client Settings
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:3000
